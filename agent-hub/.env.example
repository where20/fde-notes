# 数据库（本地开发：docker compose up -d db 后，宿主连 localhost:5433）
DB_PASSWORD=your_db_password
DATABASE_URL=postgresql://postgres:your_db_password@localhost:5433/agent_hub?schema=public

# 认证
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# 服务端口
PORT=3000

# Redis（本地开发连宿主 localhost:6379；容器内改成 redis:6379）
REDIS_HOST=localhost
REDIS_PORT=6379

# 模型（ai 模块用）
# 不配 OPENAI_API_KEY 时，/ai 会自动降级为模拟输出 —— 测试环境可放心留空，
# 既不依赖外部服务、也不消耗 token，E2E 用例照常跑通
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.minimax.cn/v1
OPENAI_MODEL=MiniMax-M2.7
