# ── 模型配置：任意 OpenAI 兼容端点都行 ─────────────────
# OpenAI 官方 / DeepSeek / 月之暗面 / 智谱 / Agnes 等，只要走 OpenAI 协议即可

OPENAI_API_KEY=sk-your-key-here

# 默认走 OpenAI 官方；指向其它兼容服务时改这里（注意保留末尾 /v1）
OPENAI_BASE_URL=https://api.openai.com/v1

# 模型名，按你所用端点支持的名字填
OPENAI_MODEL=gpt-4o-mini

# embedding 模型（仅 03-rag 用到）。留空则按端点自动推断：
#   MiniMax 端点 → embo-01；其它 OpenAI 标准端点 → text-embedding-3-small
# EMBEDDING_MODEL=
